{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dairydatascience",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "dairydatascience.com", "custom_domain": true },
    { "pattern": "www.dairydatascience.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "_site"
  }
}
