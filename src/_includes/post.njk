---
layout: base.njk
---
<nav class="back"><a href="/">{{ site.name }}</a></nav>
<article class="post">
  <header>
    <h1>{{ title }}</h1>
    <p class="byline"><time datetime="{{ page.date | isoDate }}">{{ page.date | monthYear }}</time>{% if kind %} · {{ kind }}{% endif %}</p>
  </header>
  {{ content | safe }}
</article>
